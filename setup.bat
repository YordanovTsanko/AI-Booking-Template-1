@echo off
REM =====================================================================
REM  AI-Booking-Template-1 - one-click setup (Windows)
REM  Creates the full folder structure with ALL files and installs deps.
REM  Existing .env files are NEVER overwritten.
REM  Usage: double-click setup.bat
REM =====================================================================
chcp 65001 >nul
setlocal
set "AIBT_SCRIPT=%~f0"

echo.
echo ==============================================
echo   AI-Booking-Template-1 - инсталация
echo ==============================================
echo.
echo Създавам файловете...

powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 (
  echo.
  echo [ГРЕШКА] Файловете не можаха да бъдат създадени.
  pause
  exit /b 1
)

for %%I in ("%~dp0.") do set "AIBT_DIRNAME=%%~nxI"
if /I "%AIBT_DIRNAME%"=="AI-Booking-Template-1" (
  set "AIBT_TARGET=%~dp0."
) else (
  set "AIBT_TARGET=%~dp0AI-Booking-Template-1"
)

where npm >nul 2>nul
if errorlevel 1 (
  echo.
  echo [!] Node.js / npm не е намерен. Инсталирай Node.js 18+ от https://nodejs.org
  echo     и след това пусни "npm install" в папките backend и frontend.
  goto :done
)

echo.
echo Инсталирам зависимостите на backend...
pushd "%AIBT_TARGET%\backend"
call npm install --no-audit --no-fund
popd

echo.
echo Инсталирам зависимостите на frontend...
pushd "%AIBT_TARGET%\frontend"
call npm install --no-audit --no-fund
popd

:done
echo.
echo ==============================================
echo   СЛЕДВАЩИ СТЪПКИ
echo ==============================================
echo 1) Попълни backend\.env  (MONGO_URI, JWT_SECRET ...)
echo 2) cd backend   ^&^& npm run seed ^&^& npm run dev
echo 3) cd frontend  ^&^& npm run dev
echo 4) Отвори http://localhost:5173   (admin@test.com / 123456)
echo.
pause
exit /b 0

